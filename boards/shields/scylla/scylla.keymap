#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
// -----------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5  |                    |  6  |  7   |  8   |  9   |  0   |  GRV |
// |  TAB  |  Q  |  W  |  E   |  R   |  T  |                    |  Y  |  U   |  I   |  O   |  P   |  BSPC |
// | LCTRL |  A  |  S  |  D   |  F   |  G  |                    |  H  |  J   |  K   |  L   |  ;   |  QUOT |
// | LSHFT |  Z  |  X  |  C   |  V   |  B  |                    |  N  |  M   |  ,   |  .   |  /   |  CAPS |
//                 | LGUI | MO(1) | SPC |       | ENT | MO(2) | RGUI |
//                          | LALT | SPC |       | BSPC | RALT |
			bindings = <
&kp ESC      &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4 &kp NUMBER_5                     &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp NUMBER_0 &kp GRAVE
&kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T                            &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSPC
&kp LCTRL    &kp A        &kp S        &kp D        &kp F        &kp G                            &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp SQT
&kp LSHFT    &kp Z        &kp X        &kp C        &kp V        &kp B                            &kp N        &kp M        &kp COMMA    &kp DOT      &kp SLASH    &kp CAPS
                    &kp LGUI &mo 1 &kp SPACE &kp ENTER &mo 2 &kp RGUI
                    &kp LALT &kp SPACE &kp BSPC &kp RALT
			>;
		};

		layer1 {
// -----------------------------------------------------------------------------------------------------------------
// Number / symbol layer
// |      |  1  |  2  |  3   |  4   |  5  |                    |  6  |  7   |  8   |  9   |  0   |      |
// |      |  !  |  @  |  #   |  $   |  %  |                    |  ^  |  &   |  *   |  (   |  )   |      |
			bindings = <
&trans &trans &trans &trans &trans &trans                     &trans &trans &trans &trans &trans &trans
&trans &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4 &kp NUMBER_5                     &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp NUMBER_0 &trans
&trans &kp EXCL &kp AT &kp HASH &kp DLR &kp PERCENT                     &kp CARET &kp AMPS &kp ASTERISK &kp LPAR &kp RPAR &trans
&trans &trans &trans &trans &trans &trans                     &trans &trans &trans &trans &trans &trans
                    &trans &trans &trans &trans &trans &trans
                    &trans &trans &trans &trans
			>;
		};

		layer2 {
// -----------------------------------------------------------------------------------------------------------------
// RGB / utility layer
// | BOOT |     |     |      |      |     |                    | BRI  | HUE+ | SAT+ | EFF+ | TOGG |      |
// | BOOT |     |     |      |      |     |                    | BRD  | HUE- | SAT- | EFF- |      |      |
			bindings = <
&trans &trans &trans &trans &trans &trans                     &trans &trans &trans &trans &trans &trans
&bootloader &trans &trans &trans &trans &trans                     &rgb_ug_bri &rgb_ug_hui &rgb_ug_sai &rgb_ug_eff &rgb_ug_toggle &trans
&bootloader &trans &trans &trans &trans &trans                     &rgb_ug_brd &rgb_ug_hud &rgb_ug_sad &rgb_ug_eff_rev &trans &trans
&trans &trans &trans &trans &trans &trans                     &trans &trans &trans &trans &trans &trans
                    &trans &trans &trans &trans &trans &trans
                    &trans &trans &trans &trans
			>;
		};
	};
};